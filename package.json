{
  "name": "revisons",
  "version": "1.2.0",
  "private": true,
  "description": "Révisons — leçons et exercices expliqués du CI au CM2 (site statique déployé avec Cloudflare Workers).",
  "license": "UNLICENSED",
  "author": "SDF Technologie",
  "type": "module",
  "scripts": {
    "build": "node check-content.mjs",
    "check": "node check-content.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply revisons-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply revisons-db --local"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=20"
  }
}